# SuperFast PolyBot v3 - Environment Variables
# Copy this to .env and fill in your values

# Required: Polymarket trading wallet private key (0x-prefixed)
POLYMARKET_PRIVATE_KEY=

# Deprecated: legacy name for the same value. POLYMARKET_PRIVATE_KEY is preferred
# and will be the only supported name in a future release.
# POLYBOT_PRIVATE_KEY=

# Optional: Telegram bot token from @BotFather
POLYBOT_TELEGRAM_TOKEN=

# Optional: Telegram allowed user IDs (comma-separated)
POLYBOT_TELEGRAM_ALLOWED_USER_IDS=

# Optional: HTTP API key for signal ingestion endpoint
# Leave blank to disable the optional HTTP ingestion server.
POLYBOT_API_KEY=

# Optional: Redis integrations (disabled by default for the Windows-native v3 path)
POLYBOT_REDIS_ENABLED=false
POLYBOT_REDIS_URL=redis://127.0.0.1:6379

# Optional: Execution mode (simulation | shadow | live)
POLYBOT_EXECUTION_MODE=simulation

# Optional: SQLite path for local system-of-record storage
POLYBOT_SQLITE_PATH=./polybot.db

# Optional: Override log level (default: info)
POLYBOT_LOG_LEVEL=info

# Optional but required before live mode: API key for dashboard control routes
# The dashboard sends this as X-PolyBot-Control-Key for pause/resume/emergency-stop.
POLYBOT_DASHBOARD_CONTROL_KEY=

# Optional: Override base position size in USD (default: 50)
POLYBOT_BASE_SIZE_USD=50

# =============================================================================
# === V2 Configuration (CLOB V2, go-live 2026-04-28) ===
# =============================================================================
# These variables configure the V2 protocol layer. Phase 2 parses them but
# does not yet use them for order submission (Phases 3-5). They are safe to
# leave blank in simulation mode.

# --- Relayer (gasless tx submission, PRD §5.3) ---
# All three must be provided together. Partial config is ignored.
RELAYER_URL=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# --- Builder code (V2 order signing, PRD §5.2) ---
# Bytes32 hex (0x-prefixed, 66 chars). Generate at Polymarket → Settings → Builder Profile.
BUILDER_CODE=

# --- Collateral (pUSD wrapping, PRD §6) ---
COLLATERAL_TOKEN=pUSD
COLLATERAL_ONRAMP_ADDRESS=
USDC_E_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# --- Order routing (PRD §9.1, §18) ---
# Taker-fee ceiling in true basis points. FOK orders only issued when
# feeSchedule.takerFee / 100 <= this value. Default 50 (0.50%). 0 disables FOK.
FOK_MAX_FEE_BPS=50

# --- Category position caps (USDC, PRD §10.5) ---
MAX_POSITION_POLITICS_USDC=250
MAX_POSITION_CRYPTO_USDC=150
MAX_POSITION_SPORTS_USDC=200
MAX_POSITION_OTHER_USDC=100

# ─── Reconciliation (safety: default off) ───
# When true, full reconciliation cycles may OVERWRITE in-memory
# positions to match the reference (data-api or SQLite). When
# false, drift is logged and alerted but no state mutation.
#
# Default: false. Only enable after running with auto_heal=false
# for 2+ weeks and confirming the "would heal" log lines don't
# overwrite real positions that just haven't been indexed yet.
# POLYBOT_RECONCILIATION_AUTO_HEAL=false
